@router.get("/api/phoenix/system-control/github-stats")
def phoenix_system_control_github_stats():
    """
    GitHub-Traffic-Statistiken ausschließlich serverseitig.
    Keine Token-Ausgabe und keine GitHub-Schreiboperation.
    """
    import urllib.request
    from urllib.error import HTTPError, URLError

    if not _phoenix_developer_mode_enabled():
        raise HTTPException(
            status_code=403,
            detail="Developer Mode ist nicht aktiv.",
        )

    token = _phoenix_github_token()

    if not token:
        raise HTTPException(
            status_code=503,
            detail="GitHub-Token nicht verfügbar.",
        )

    base_url = (
        "https://api.github.com/repos/"
        "FairestDoc2/dr-ronny-os-apps/traffic/"
    )

    results = {}

    for name in ("views", "clones"):
        request = urllib.request.Request(
            base_url + name,
            headers={
                "Authorization": f"Bearer {token}",
                "Accept": "application/vnd.github+json",
                "User-Agent": "Dr-Ronny-OS-Phoenix",
                "X-GitHub-Api-Version": "2022-11-28",
            },
        )

        try:
            with urllib.request.urlopen(
                request,
                timeout=15,
            ) as response:
                data = json.load(response)

            results[name] = {
                "status": "ok",
                "count": data.get("count"),
                "uniques": data.get("uniques"),
            }

        except HTTPError as exc:
            results[name] = {
                "status": "error",
                "http_status": exc.code,
            }

        except (URLError, TimeoutError):
            results[name] = {
                "status": "error",
                "network_error": True,
            }

        except (ValueError, TypeError):
            results[name] = {
                "status": "error",
                "invalid_response": True,
            }

    return {
        "status": (
            "ok"
            if all(
                item["status"] == "ok"
                for item in results.values()
            )
            else "partial_error"
        ),
        "repository": "FairestDoc2/dr-ronny-os-apps",
        "period": "github_traffic_last_14_days",
        "views": results["views"],
        "clones": results["clones"],
    }


